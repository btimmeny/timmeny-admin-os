MONDAY_API_TOKEN=
TIMMENY_OS_API_KEY=
# Board: To Do List
TODO_BOARD_ID=8962223984
TODO_GROUP_ID=
# Board: GS | Initiatives & Action Items
GS_TODO_BOARD_ID=
GS_TODO_GROUP_ID=
# Optional group override for Key Initiatives inside the GS board
GS_KEY_INITIATIVES_GROUP_ID=
# Operational state. Leave blank to run without persistence.
DATABASE_URL=
# Gmail intake. Leave the OAuth values blank to run without Gmail.
# See docs/77-First-Slice-Setup.md for how to mint the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Capability configuration. The labels in scope are named there, not here.
CAPABILITIES_PATH=
# The playbook a fresh database is seeded from. After that, the database holds it.
ASSISTANT_PLAYBOOK_PATH=
# Gmail writes (labelling, archiving) stay off until the read loop is trusted.
GMAIL_WRITE_ENABLED=false
LOG_LEVEL=INFO
